        },
        {
          "tex": [
            "N"
          ],
          "role": "quantity",
          "meaning": "number of cascaded PT1 sections",
          "space": "positive integers"
        },
        {
          "tex": [
            "z"
          ],
          "role": "quantity",
          "meaning": "complex frequency variable of the z transform",
          "space": "complex numbers"
        },
        {
          "tex": [
            "H"
          ],
          "role": "quantity",
          "meaning": "transfer function of one constant-coefficient filter section",
          "space": "complex-valued rational function"
        },
        {
          "tex": [
            "\\mathrm{center}",
            "\\mathrm{lower}"
          ],
          "role": "label",
          "meaning": "static-notch center and lower cutoff frequency labels",
          "space": "fixed labels"
        },
        {
          "tex": [
            "\\gamma"
          ],
          "role": "quantity",
          "meaning": "positive per-stage analog cutoff multiplier for a cascade of identical first-order sections",
          "space": "positive real, dimensionless"
        }
