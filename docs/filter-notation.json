          ],
          "role": "quantity",
          "meaning": "biquad quality factor",
          "space": "positive real"
        },
        {
          "tex": [
            "\\omega"
          ],
          "role": "quantity",
          "meaning": "normalized angular cutoff frequency",
          "space": "real radians per sample"
        },
        {
          "tex": [
            "\\alpha"
          ],
          "role": "quantity",
          "meaning": "biquad damping coefficient sin(omega)/(2Q)",
