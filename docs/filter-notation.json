        {
          "tex": [
            "\\rho"
          ],
          "role": "quantity",
          "meaning": "mean candidate to baseline output energy ratio within one flight block",
          "space": "positive real, dimensionless"
        },
        {
          "tex": [
            "d"
          ],
          "role": "quantity",
          "meaning": "noise change for one flight block",
          "space": "real, decibels"
        },
        {
          "tex": [
            "f"
          ],
          "role": "quantity",
          "meaning": "frequency, with s and c labels identifying sample rate and stage cutoff",
          "space": "positive real, hertz"
        },
        {
          "tex": [
            "s",
            "c"
          ],
          "role": "label",
          "meaning": "sample-rate and cutoff labels, respectively",
          "space": "fixed frequency labels"
        },
        {
          "tex": [
            "n"
          ],
          "role": "index",
          "meaning": "discrete sample index",
          "space": "integers"
        },
        {
          "tex": [
            "x",
            "y"
          ],
          "role": "quantity",
          "meaning": "input and output sample sequences of the current filter stage",
          "space": "real sequences"
        },
        {
          "tex": [
            "g"
          ],
          "role": "quantity",
          "meaning": "PT1 update gain",
          "space": "real in (0,1)"
        },
        {
          "tex": [
            "W"
          ],
          "role": "quantity",
          "meaning": "prewarped normalized frequency of a first-order section",
          "space": "positive real"
